<?xml version="1.0" encoding="utf-8"?>
<!--
  Đóng gói thành 1 file ZaloMultiWorkspace.exe chạy độc lập (không cần cài .NET).
  Lệnh: dotnet publish ZaloMultiWorkspace/ZaloMultiWorkspace.csproj -p:PublishProfile=SingleFile
  Kết quả: thư mục Publish/ ở gốc repo.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Gộp cả DLL native (WebView2Loader...) vào exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Nén để giảm dung lượng file exe -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Không xuất các file tài liệu .xml của thư viện -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>..\Publish\</PublishDir>
  </PropertyGroup>
</Project>
