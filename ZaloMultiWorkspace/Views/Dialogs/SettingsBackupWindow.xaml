<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.SettingsBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Height="720" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Nút chọn giao diện dạng icon (nhóm 3 nút liền nhau) -->
        <Style x:Key="ThemeSegmentStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeMode"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#0068FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab đầu hộp thoại: icon + nhãn ngắn -->
        <Style x:Key="SettingsTabStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsTab"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tab" Background="Transparent" CornerRadius="6" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="#0068FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource ThemeSegmentStyle}">
            <Setter Property="GroupName" Value="TranslateProvider"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Dòng cài đặt: icon | tiêu đề + mô tả | công tắc -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>
    </Window.Resources>

    <Border Padding="20,16,20,20" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <!-- Thanh tab -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabGeneral" Content="Chung" Tag="&#xE713;" Style="{StaticResource SettingsTabStyle}"
                                 IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNotify" Content="Thông báo" Tag="&#xEA8F;" Style="{StaticResource SettingsTabStyle}"
                                 Margin="2,0" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSecurity" Content="Bảo mật" Tag="&#xE72E;" Style="{StaticResource SettingsTabStyle}"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabBackup" Content="Sao lưu" Tag="&#xE777;" Style="{StaticResource SettingsTabStyle}"
                                 Margin="2,0" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabTranslate" Content="Dịch" Tag="&#xE8C1;" Style="{StaticResource SettingsTabStyle}"
                                 Margin="0,0,2,0" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabAbout" Content="Thông tin" Tag="&#xE946;" Style="{StaticResource SettingsTabStyle}"
                                 Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" Width="110" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Lưu" Width="110" Height="34" Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- Nội dung các tab cuộn được khi dài hơn hộp thoại (vd tab Dịch khi chọn AI) -->
            <ScrollViewer x:Name="TabContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <Grid>
                <!-- ===== TAB CHUNG ===== -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Text="GIAO DIỆN" Style="{StaticResource SectionTitle}"/>
                    <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="&#xE7F4;" Tag="System" ToolTip="Theo Windows" Style="{StaticResource ThemeSegmentStyle}"
                                         IsChecked="{Binding IsThemeSystem, Mode=OneWay}" Click="ThemeSegment_Click"
                                         AutomationProperties.Name="Theo Windows"/>
                            <RadioButton Content="&#xE706;" Tag="Light" ToolTip="Sáng" Style="{StaticResource ThemeSegmentStyle}" Margin="2,0"
                                         IsChecked="{Binding IsThemeLight, Mode=OneWay}" Click="ThemeSegment_Click"
                                         AutomationProperties.Name="Sáng"/>
                            <RadioButton Content="&#xE708;" Tag="Dark" ToolTip="Tối" Style="{StaticResource ThemeSegmentStyle}"
                                         IsChecked="{Binding IsThemeDark, Mode=OneWay}" Click="ThemeSegment_Click"
                                         AutomationProperties.Name="Tối"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BỐ CỤC TÀI KHOẢN" Style="{StaticResource SectionTitle}"/>
                    <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab ngang: icon "dock trái" xoay 90 độ thành "dock trên" -->
                            <RadioButton Tag="Horizontal" GroupName="AccountLayout" ToolTip="Ngang (tab phía trên)" Style="{StaticResource ThemeSegmentStyle}"
                                         IsChecked="{Binding IsHorizontalLayout, Mode=OneWay}" Click="LayoutSegment_Click"
                                         AutomationProperties.Name="Bố cục ngang">
                                <TextBlock Text="&#xE90C;">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton Content="&#xE90C;" Tag="Vertical" GroupName="AccountLayout" ToolTip="Dọc (thanh bên trái)" Style="{StaticResource ThemeSegmentStyle}" Margin="2,0,0,0"
                                         IsChecked="{Binding IsVerticalLayout, Mode=OneWay}" Click="LayoutSegment_Click"
                                         AutomationProperties.Name="Bố cục dọc"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CỬA SỔ" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Mở cùng Windows"/>
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Mở cùng Windows" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Chạy ngầm ở khay khi bật máy, các tài khoản tự khởi chạy để nhận tin" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Thu nhỏ xuống khay khi bấm X"/>
                            <TextBlock Text="&#xE70E;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Thu nhỏ xuống khay khi bấm ✕" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Ứng dụng tiếp tục chạy ngầm để nhận tin nhắn" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="30,9,0,9"
                            IsEnabled="{Binding IsChecked, ElementName=MinimizeToTrayCheckBox}">
                        <DockPanel>
                            <CheckBox x:Name="TrayHintSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Báo khi ẩn xuống khay"/>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Báo khi ẩn xuống khay" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Hiện thông báo nhắc ứng dụng vẫn đang chạy" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===== TAB THÔNG BÁO ===== -->
                <StackPanel x:Name="PanelNotify" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="ToastPopupSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Popup góc màn hình"/>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Popup góc màn hình" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Hiện khi cửa sổ đang ẩn hoặc tin đến từ tài khoản khác" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" Padding="30,9,0,9"
                            IsEnabled="{Binding IsChecked, ElementName=ToastPopupSwitch}">
                        <DockPanel>
                            <CheckBox x:Name="HideContentSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Ẩn nội dung tin nhắn"/>
                            <TextBlock Text="&#xED1A;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Ẩn nội dung tin nhắn" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Chỉ hiện tên tài khoản — tránh lộ thông tin khi chia sẻ màn hình" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="InAppBannerSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Thanh thông báo trong ứng dụng"/>
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Thanh thông báo trong ứng dụng" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Dải xanh &quot;Xem ngay&quot; phía trên khung chat" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Âm thanh khi có tin mới"/>
                            <TextBlock Text="&#xE767;" Style="{StaticResource RowIcon}"/>
                            <TextBlock Text="Âm thanh khi có tin mới" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox x:Name="BadgeSwitch" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Chấm đỏ báo tin chưa đọc"/>
                            <TextBlock Text="&#xEA3B;" Style="{StaticResource RowIcon}" Foreground="#E5293E"/>
                            <StackPanel>
                                <TextBlock Text="Chấm đỏ báo tin chưa đọc" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Trên icon khay và thanh taskbar" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <StackPanel>
                            <DockPanel>
                                <ComboBox x:Name="DndModeCombo" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center"
                                          SelectionChanged="DndModeCombo_SelectionChanged" AutomationProperties.Name="Không làm phiền">
                                    <ComboBoxItem Content="Tắt"/>
                                    <ComboBoxItem Content="Theo khung giờ"/>
                                    <ComboBoxItem Content="Tạm tắt 1 giờ"/>
                                </ComboBox>
                                <TextBlock Text="&#xE708;" Style="{StaticResource RowIcon}"/>
                                <StackPanel>
                                    <TextBlock Text="Không làm phiền" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="DndHintText" Text="Tắt popup và âm thanh; chấm đỏ vẫn hiện" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="DndSchedulePanel" Orientation="Horizontal" Margin="30,8,0,0" Visibility="Collapsed">
                                <TextBlock Text="Từ" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,8,0"/>
                                <TextBox x:Name="DndStartTextBox" Width="70" AutomationProperties.Name="Bắt đầu không làm phiền"/>
                                <TextBlock Text="đến" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="10,0,8,0"/>
                                <TextBox x:Name="DndEndTextBox" Width="70" AutomationProperties.Name="Kết thúc không làm phiền"/>
                                <TextBlock Text="(HH:mm)" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Muốn tắt thông báo riêng một tài khoản: chuột phải vào avatar tài khoản đó." Style="{StaticResource RowHint}" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- ===== TAB BẢO MẬT ===== -->
                <StackPanel x:Name="PanelSecurity" Visibility="Collapsed">
                    <TextBlock Text="KHÓA ỨNG DỤNG" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã PIN mới (để trống = giữ mã hiện tại):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PinTextBox"/>
                            <TextBlock x:Name="DefaultPinWarningText" Text="⚠️ Đang dùng mã PIN mặc định 1234 - hãy đổi mã PIN!"
                                       FontSize="11" Foreground="{DynamicResource Brush.Warning.Text}" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tự khóa sau (phút)" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="IdleMinutesTextBox"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <CheckBox x:Name="AutoLockCheckBox" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Tự động khóa khi không thao tác"/>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource RowIcon}"/>
                            <StackPanel>
                                <TextBlock Text="Tự động khóa khi không thao tác" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Yêu cầu nhập mã PIN để mở lại (Ctrl + L để khóa ngay)" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ===== TAB DỊCH ===== -->
                <StackPanel x:Name="PanelTranslate" Visibility="Collapsed">
                    <TextBlock Text="DỊCH VỤ DỊCH" Style="{StaticResource SectionTitle}"/>
                    <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ProviderGoogle" Content="Google Dịch" Tag="GoogleFree" Style="{StaticResource ProviderSegmentStyle}"
                                         Checked="Provider_Checked" AutomationProperties.Name="Google Dịch"/>
                            <RadioButton x:Name="ProviderAi" Content="AI (API)" Tag="Ai" Style="{StaticResource ProviderSegmentStyle}" Margin="2,0,0,0"
                                         Checked="Provider_Checked" AutomationProperties.Name="AI (API)"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ProviderHintText" Style="{StaticResource RowHint}" Margin="0,0,0,12"/>

                    <!-- Cấu hình AI: nhà cung cấp, API URL, API key, mô hình -->
                    <StackPanel x:Name="AiPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nhà cung cấp" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="AiPresetCombo" DisplayMemberPath="Name" Height="34" SelectionChanged="AiPresetCombo_SelectionChanged"
                                          AutomationProperties.Name="Nhà cung cấp AI"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="AiPresetHint" Style="{StaticResource RowHint}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </Grid>
                        <TextBlock Text="API URL" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiUrlBox" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12"
                                 TextChanged="AiUrlBox_TextChanged" AutomationProperties.Name="API URL"/>
                        <TextBlock x:Name="AiUrlHint" Style="{StaticResource RowHint}" Margin="0,4,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="API key" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="AiKeyBox" Height="34" Padding="8,0" VerticalContentAlignment="Center" AutomationProperties.Name="API key"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mô hình" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AiModelBox" Height="34" Padding="8,0" VerticalContentAlignment="Center" AutomationProperties.Name="Mô hình AI"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Kiểm tra" Click="TestProvider_Click" VerticalAlignment="Bottom" Height="34" Width="90"/>
                        </Grid>
                    </StackPanel>

                    <!-- Prompt cho Gemini / DeepSeek (ẩn khi chọn Google Dịch) -->
                    <StackPanel x:Name="PromptPanel" Visibility="Collapsed" Margin="0,2,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Thêm mẫu: Thiết kế điện" FontSize="11" Padding="10,3" Margin="0,0,6,0" Click="AddElectricalPreset_Click"
                                        ToolTip="Thêm thuật ngữ ngành thiết kế - thi công điện vào cuối prompt"/>
                                <Button Content="Khôi phục mặc định" FontSize="11" Padding="10,3" Click="ResetPrompt_Click"/>
                            </StackPanel>
                            <TextBlock Text="Prompt dịch" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Bottom"/>
                        </DockPanel>
                        <TextBox x:Name="PromptBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontSize="12" AutomationProperties.Name="Prompt dịch"/>
                    </StackPanel>

                    <TextBlock x:Name="TestStatusText" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>

                    <TextBlock Text="NGÔN NGỮ GHIM (CHỌN NHANH KHI SOẠN TIN)" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="Pin1Combo" Grid.Column="0" DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Ngôn ngữ ghim 1"/>
                        <ComboBox x:Name="Pin2Combo" Grid.Column="2" DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Ngôn ngữ ghim 2"/>
                        <ComboBox x:Name="Pin3Combo" Grid.Column="4" DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Ngôn ngữ ghim 3"/>
                    </Grid>
                    <TextBlock Style="{StaticResource RowHint}"
                               Text="Chỉ gửi nội dung đi dịch khi bạn bấm Dịch. Khóa API được Windows mã hóa và chỉ dùng được trên máy, tài khoản Windows này."/>
                </StackPanel>

                <!-- ===== TAB THÔNG TIN ===== -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,14">
                        <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,14,0" ClipToBounds="True">
                            <Image x:Name="AboutLogo" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chat Workspace Pro" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
