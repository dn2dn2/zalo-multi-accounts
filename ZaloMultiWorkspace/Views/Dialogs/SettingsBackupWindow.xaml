<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.SettingsBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Hệ thống &amp; Sao lưu Profile" Height="600" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Nút chọn giao diện dạng icon (nhóm 3 nút liền nhau) -->
        <Style x:Key="ThemeSegmentStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeMode"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#0068FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" Width="90" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="💾 Lưu cài đặt" Width="125" Height="34" Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="GIAO DIỆN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,8"/>
                <Border HorizontalAlignment="Left" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                        BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="&#xE7F4;" Tag="System" ToolTip="Theo Windows" Style="{StaticResource ThemeSegmentStyle}"
                                     IsChecked="{Binding IsThemeSystem, Mode=OneWay}" Click="ThemeSegment_Click"
                                     AutomationProperties.Name="Theo Windows"/>
                        <RadioButton Content="&#xE706;" Tag="Light" ToolTip="Sáng" Style="{StaticResource ThemeSegmentStyle}" Margin="2,0"
                                     IsChecked="{Binding IsThemeLight, Mode=OneWay}" Click="ThemeSegment_Click"
                                     AutomationProperties.Name="Sáng"/>
                        <RadioButton Content="&#xE708;" Tag="Dark" ToolTip="Tối" Style="{StaticResource ThemeSegmentStyle}"
                                     IsChecked="{Binding IsThemeDark, Mode=OneWay}" Click="ThemeSegment_Click"
                                     AutomationProperties.Name="Tối"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="BẢO MẬT &amp; KHAY HỆ THỐNG (MASTER LOCK)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã PIN mới (để trống = giữ mã hiện tại):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PinTextBox"/>
                        <TextBlock x:Name="DefaultPinWarningText" Text="⚠️ Đang dùng mã PIN mặc định 1234 - hãy đổi mã PIN!"
                                   FontSize="11" Foreground="{DynamicResource Brush.Warning.Text}" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tự khóa sau (phút rảnh):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IdleMinutesTextBox"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="AutoLockCheckBox" Content="Tự động khóa ứng dụng bằng mã PIN khi không thao tác"
                          Foreground="{DynamicResource Brush.Text.Body}" Margin="0,0,0,8"/>
                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Thu nhỏ xuống khay hệ thống (System Tray) khi bấm nút [✕]"
                          Foreground="{DynamicResource Brush.Text.Body}" Margin="0,0,0,14"/>

                <Separator Background="{DynamicResource Brush.Border.Subtle}" Margin="0,4,0,14"/>

                <TextBlock Text="SAO LƯU &amp; DI CHUYỂN DỮ LIỆU (BACKUP / RESTORE)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,8"/>
                <TextBlock Text="Hệ thống sẽ tự động chuyển toàn bộ tài khoản về chế độ Ngủ đông để mở khóa Cookie/IndexedDB trước khi đóng gói hoặc khôi phục (bỏ qua thư mục Cache). Lưu ý: phiên đăng nhập Zalo và mật khẩu Proxy được Windows mã hóa theo tài khoản người dùng, nên bản backup chỉ khôi phục đầy đủ trên cùng tài khoản Windows."
                           FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="📦 Xuất Backup (.zip)" Height="36" Click="Backup_Click"
                            Background="{DynamicResource Brush.Bg.Control}" Foreground="{DynamicResource Brush.Success.TextSoft}" BorderBrush="{DynamicResource Brush.Success.SoftBg}" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="📥 Khôi phục từ .zip" Height="36" Click="Restore_Click"
                            Background="{DynamicResource Brush.Bg.Control}" Foreground="{DynamicResource Brush.Accent.TextSoft}" BorderBrush="{DynamicResource Brush.Accent.SoftBg}" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>

                <Border Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBlock x:Name="BackupStatusText" Text="Sẵn sàng sao lưu hoặc khôi phục dữ liệu Profile."
                               FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

