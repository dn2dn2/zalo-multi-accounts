<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.QuickReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Chỉnh sửa Tin nhắn mẫu (Quick Reply)" Height="440" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="Segoe UI">

        <Border Padding="20" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="90" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="💾 Lưu tin mẫu" Width="125" Height="34" Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="THÔNG TIN TIN NHẮN MẪU" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phím tắt (VD: /baogia):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShortcutTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tiêu đề gợi nhớ:" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleTextBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nội dung văn bản (sẽ chèn vào #richInput của Zalo):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="ContentTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Hình ảnh báo giá / kỹ thuật đính kèm (Tùy chọn):" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="📁 Chọn ảnh..." Padding="10,6" Margin="8,0,0,0" Click="BrowseImage_Click"/>
                    <TextBox x:Name="ImagePathTextBox" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

