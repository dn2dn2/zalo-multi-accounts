<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.QuickReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Chỉnh sửa Tin nhắn mẫu (Quick Reply)" Height="440" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1C1C21" Foreground="#F4F4F6" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#26262E"/>
            <Setter Property="Foreground" Value="#F4F4F6"/>
            <Setter Property="BorderBrush" Value="#32323D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#F4F4F6"/>
        </Style>
    </Window.Resources>

    <Border Padding="20" BorderBrush="#2E2E38" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="90" Height="34" Margin="0,0,10,0" Click="Cancel_Click"
                        Background="#26262E" Foreground="#E4E4E7" BorderBrush="#32323D" Cursor="Hand"/>
                <Button Content="💾 Lưu tin mẫu" Width="125" Height="34" Click="Save_Click"
                        Background="#0068FF" Foreground="White" BorderBrush="#0068FF" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="THÔNG TIN TIN NHẮN MẪU" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phím tắt (VD: /baogia):" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShortcutTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tiêu đề gợi nhớ:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleTextBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nội dung văn bản (sẽ chèn vào #richInput của Zalo):" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                <TextBox x:Name="ContentTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Hình ảnh báo giá / kỹ thuật đính kèm (Tùy chọn):" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="📁 Chọn ảnh..." Padding="10,6" Margin="8,0,0,0" Click="BrowseImage_Click"
                            Background="#26262E" Foreground="#E4E4E7" BorderBrush="#32323D" Cursor="Hand"/>
                    <TextBox x:Name="ImagePathTextBox" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

