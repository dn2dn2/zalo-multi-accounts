<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.QuickReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Chỉnh sửa Tin nhắn mẫu (Quick Reply)" Height="490" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="Segoe UI">

        <Border Padding="20" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="110" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Lưu" Width="110" Height="34" Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="THÊM TIN NHẮN MẪU" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phím tắt (vd: /baogia)" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShortcutTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tiêu đề" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleTextBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource Brush.Danger.Text}" TextWrapping="Wrap"
                           Margin="0,-4,0,8" Visibility="Collapsed"/>

                <TextBlock Text="Nội dung tin nhắn" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="ContentTextBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Ảnh đính kèm (không bắt buộc)" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button x:Name="ClearImageButton" DockPanel.Dock="Right" Content="Bỏ ảnh" Padding="10,6" Margin="6,0,0,0"
                            Click="ClearImage_Click" ToolTip="Bỏ ảnh đính kèm khỏi tin mẫu"/>
                    <Button DockPanel.Dock="Right" Content="Chọn ảnh…" Padding="10,6" Margin="8,0,0,0" Click="BrowseImage_Click"/>
                    <TextBox x:Name="ImagePathTextBox" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

