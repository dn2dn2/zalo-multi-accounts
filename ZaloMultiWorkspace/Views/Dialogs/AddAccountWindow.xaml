<Window x:Class="ZaloMultiWorkspace.Views.Dialogs.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình tài khoản" Height="770" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="EditHintVis"/>
        <!-- Thẻ chọn nền tảng: viền xanh khi được chọn -->
        <Style x:Key="PlatformCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="{DynamicResource Brush.Border.Control}"
                                BorderThickness="1.5" CornerRadius="10" Padding="10,12">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Text.Disabled}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#0068FF"/>
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource Brush.Hover.Overlay}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Border Padding="20" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="110" Height="34" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Lưu" Width="110" Height="34"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="NỀN TẢNG" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PlatformCardStyle}" Tag="{Binding IsZaloSelected}"
                                Command="{Binding SelectPlatformCommand}" CommandParameter="Zalo" IsEnabled="{Binding CanChangePlatform}"
                                AutomationProperties.Name="Zalo">
                            <StackPanel>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#0068FF" HorizontalAlignment="Center">
                                    <TextBlock Text="Zalo" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Zalo" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Text="chat.zalo.me" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PlatformCardStyle}" Tag="{Binding IsTelegramSelected}"
                                Command="{Binding SelectPlatformCommand}" CommandParameter="Telegram" IsEnabled="{Binding CanChangePlatform}"
                                AutomationProperties.Name="Telegram">
                            <StackPanel>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#229ED9" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Telegram" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Text="web.telegram.org" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Không đổi được nền tảng sau khi đã tạo tài khoản." FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,-8,0,16"
                               Visibility="{Binding IsEditMode, Converter={StaticResource EditHintVis}}"/>

                    <TextBlock Text="THÔNG TIN TÀI KHOẢN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,10"/>

                    <TextBlock Text="Tên hiển thị (vd: Kỹ thuật 01)" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nhóm / bộ phận" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TagCategory, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tự tạm dừng sau (phút)" ToolTip="0 = không bao giờ tự tạm dừng (luôn nhận tin)" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AutoHibernateMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource Brush.Border.Subtle}" Margin="0,4,0,12"/>

                    <DockPanel Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoStartOnLaunch}" AutomationProperties.Name="Tự khởi chạy khi mở ứng dụng"/>
                        <StackPanel>
                            <TextBlock Text="Tự khởi chạy khi mở ứng dụng" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="Nhận tin ngay, không cần bấm Khởi chạy. Tự tạm dừng = 0 để không bao giờ dừng." FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="PROXY (KHÔNG BẮT BUỘC)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Giao thức" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding ProxyType}">
                                <ComboBoxItem Content="http"/>
                                <ComboBoxItem Content="socks5"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Địa chỉ proxy" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cổng" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProxyPortText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên đăng nhập" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProxyUser, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mật khẩu" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProxyPass, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Kiểm tra kết nối" Padding="10,5"
                                    Command="{Binding TestProxyCommand}"/>
                            <TextBlock Text="{Binding ProxyTestStatus}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

