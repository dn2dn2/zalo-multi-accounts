<Window x:Class="ZaloMultiWorkspace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:models="clr-namespace:ZaloMultiWorkspace.Models"
        Title="Chat Workspace Pro" Height="760" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Bg.App}" Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Border.Control}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Font icon hệ thống: Segoe Fluent Icons (Win 11), tự fallback Segoe MDL2 Assets (Win 10) -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Tooltip tối màu dùng chung toàn cửa sổ -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Tooltip.Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Tooltip.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút chỉ có icon 32x32, nội dung (Content) là mã glyph -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Border.Control}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Biến thể bật/tắt: sáng xanh khi khung Trợ lý CSKH đang mở -->
        <Style x:Key="DrawerToggleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRightDrawerOpen}" Value="True">
                    <Setter Property="Background" Value="#1A0068FF"/>
                    <Setter Property="BorderBrush" Value="#0068FF"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,5,0"/>
        </Style>

        <Style x:Key="QuickReplyCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Thẻ tin mẫu: viền đậm khi rê chuột, viền xanh lá ngắn sau khi vừa sửa -->
        <Style x:Key="QuickReplyItemCardStyle" TargetType="Border" BasedOn="{StaticResource QuickReplyCardStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Tooltip.Border}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsJustUpdated}" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút icon nhỏ trên thẻ (Sửa / Xóa) -->
        <Style x:Key="CardIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Nhóm nút trên thẻ: mờ, rõ lên khi rê chuột vào thẻ -->
        <Style x:Key="CardActionsStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tooltip và menu chuột phải dùng chung cho thanh dọc và tab ngang -->
        <ToolTip x:Key="AccountToolTip" x:Shared="False" Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="{Binding PlatformName}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                <TextBlock Text="⏸ Đang tạm dừng — không nhận tin mới" Foreground="{DynamicResource Brush.Warning.Text}" FontSize="11"
                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding TagCategory}" Foreground="{DynamicResource Brush.Accent.TextSoft}" FontSize="11"/>
                <TextBlock Text="{Binding ProxyDisplayText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                <TextBlock Text="🔕 Đã tắt thông báo" Foreground="{DynamicResource Brush.Warning.Text}" FontSize="11"
                           Visibility="{Binding IsNotificationMuted, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ToolTip>

        <ContextMenu x:Key="AccountContextMenu" x:Shared="False" Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <MenuItem Header="Khởi chạy" Click="ContextWakeAccount_Click" CommandParameter="{Binding}"/>
            <MenuItem Header="Tạm dừng" Click="ContextHibernateAccount_Click" CommandParameter="{Binding}"/>
            <MenuItem Header="Cấu hình tài khoản" Click="ContextEditAccount_Click" CommandParameter="{Binding}"/>
            <MenuItem Header="Mở thư mục dữ liệu" Click="ContextOpenFolder_Click" CommandParameter="{Binding}"/>
            <MenuItem Header="{Binding MuteMenuHeader}" Click="ContextToggleMute_Click" CommandParameter="{Binding}"/>
            <Separator Background="{DynamicResource Brush.Border.Subtle}"/>
            <MenuItem Header="Xóa tài khoản" Foreground="{DynamicResource Brush.Danger.Text}" Click="ContextDeleteAccount_Click" CommandParameter="{Binding}"/>
        </ContextMenu>


        <!-- Ký hiệu nền tảng trên huy hiệu: "Z" (chữ) hoặc máy bay giấy (font icon) -->
        <Style x:Key="PlatformGlyphStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding PlatformGlyph}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTelegram}" Value="True">
                    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút tab khung bên phải (Tin mẫu / Ghi chú / Dịch): nền xanh khi đang mở -->
        <Style x:Key="DrawerTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0068FF"/>
                    <Setter Property="BorderBrush" Value="#0068FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thẻ trong tab Dịch -->
        <Style x:Key="TranslateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Tab tài khoản (bố cục ngang) ===== -->
        <Style x:Key="AccountTabStyle" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MaxWidth" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Panel}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#22C55E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Hibernated">
                    <Setter Property="Fill" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionStatus}" Value="ProxyError">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connecting">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Text}"/>
                </DataTrigger>
                <!-- Có tin chưa đọc thì hiện số thay cho chấm trạng thái -->
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- System Tray Icon (Giai đoạn 5) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Assets/app.ico"
                        ToolTipText="Chat Workspace Pro"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="{DynamicResource Brush.Bg.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                    <MenuItem Header="Mở ứng dụng" Click="TrayOpen_Click"/>
                    <MenuItem Header="Khóa ngay" Click="TrayLock_Click"/>
                    <MenuItem Header="Tạm dừng tất cả" Click="TrayHibernateAll_Click"/>
                    <Separator Background="{DynamicResource Brush.Border.Subtle}"/>
                    <MenuItem Header="Thoát" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>


        <!-- ZONE 1 (bố cục ngang): DẢI TAB TÀI KHOẢN -->
        <Border Grid.Row="0" Height="40" Background="{DynamicResource Brush.Bg.App}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsHorizontalLayout, Converter={StaticResource BoolToVis}}">
            <ScrollViewer x:Name="AccountTabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="AccountTabScroller_PreviewMouseWheel" Padding="8,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding Accounts}" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ZaloAccountProfile}">
                                <Border Style="{StaticResource AccountTabStyle}"
                                        MouseLeftButtonDown="AccountItem_MouseLeftButtonDown" Tag="{Binding}"
                                        ToolTip="{StaticResource AccountToolTip}"
                                        ContextMenu="{StaticResource AccountContextMenu}"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                    <Grid>
                                        <!-- Vạch xanh trên tab đang chọn -->
                                        <Border Height="2" VerticalAlignment="Top" Margin="-10,0" CornerRadius="2,2,0,0" Background="#0068FF"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Avatar nhỏ: ảnh hoặc chữ viết tắt trên màu nhóm -->
                                            <Grid Width="20" Height="20" Margin="0,0,8,0">
                                                <Ellipse Fill="{Binding TagColor}"/>
                                                <TextBlock Text="{Binding Initials}" FontSize="8" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,-4,-3"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Background="{Binding PlatformColor}" BorderBrush="{DynamicResource Brush.Bg.App}" BorderThickness="1.5">
                                                    <TextBlock Style="{StaticResource PlatformGlyphStyle}" FontSize="5.5"/>
                                                </Border>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Hibernated">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Chuông gạch khi đã tắt thông báo -->
                                            <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsNotificationMuted, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Số tin chưa đọc -->
                                            <Border Background="#E5293E" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Chấm trạng thái (ẩn khi đang có số tin chưa đọc) -->
                                            <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusDotStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#xE710;" Style="{StaticResource IconButtonStyle}" Foreground="#0068FF"
                            Width="28" Height="28" Margin="4,0,0,2" VerticalAlignment="Bottom"
                            Click="AddAccount_Click" ToolTip="Thêm tài khoản" AutomationProperties.Name="Thêm tài khoản"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ZONE 1: LEFT ACCOUNT RAIL -->
            <Border Grid.Column="0" Width="68" Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsVerticalLayout, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,14" HorizontalAlignment="Center">
                        <Separator Background="{DynamicResource Brush.Border.Subtle}" Margin="10,0,10,12"/>
                        <Button Width="44" Height="44" Margin="0,0,0,10" ToolTip="Thêm tài khoản"
                                Click="AddAccount_Click"
                                Style="{StaticResource ToolbarButtonStyle}" Background="{DynamicResource Brush.Bg.Control}" BorderBrush="#0068FF">
                            <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#0068FF" Margin="0,-2,0,0"/>
                        </Button>
                        <Button Width="44" Height="44" ToolTip="Cài đặt hệ thống &amp; Sao lưu"
                                Click="OpenSettings_Click"
                                Style="{StaticResource ToolbarButtonStyle}">
                            <TextBlock Text="⚙" FontSize="18"/>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ZaloAccountProfile}">
                                    <Grid Width="68" Height="56" Margin="0,0,0,8" Cursor="Hand"
                                          Background="Transparent"
                                          MouseLeftButtonDown="AccountItem_MouseLeftButtonDown"
                                          Tag="{Binding}"
                                          ToolTip="{StaticResource AccountToolTip}"
                                          ContextMenu="{StaticResource AccountContextMenu}">



                                        <!-- Vạch chỉ thị Active (#0068FF) -->
                                        <Border Width="4" Height="36" Background="#0068FF" CornerRadius="0,3,3,0" HorizontalAlignment="Left"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Avatar vòng tròn -->
                                        <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Tooltip.Border}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#0068FF"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Text}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Hibernated">
                                                            <Setter Property="Opacity" Value="0.65"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                            <Style.Triggers>
                                                                <!-- Nền xanh khi đang chọn -> chữ trắng ở cả 2 giao diện -->
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Ellipse Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>

                                        <!-- Huy hiệu nền tảng (Zalo / Telegram) -->
                                        <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,3,0,0"
                                                Background="{Binding PlatformColor}" BorderBrush="{DynamicResource Brush.Bg.App}" BorderThickness="2">
                                            <TextBlock Style="{StaticResource PlatformGlyphStyle}" FontSize="7"/>
                                        </Border>

                                        <!-- Badge đỏ số tin nhắn chưa đọc -->
                                        <Border Background="#EF4444" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0"
                                                BorderBrush="{DynamicResource Brush.Bg.App}" BorderThickness="2"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Biểu tượng chuông gạch khi tài khoản đã tắt thông báo -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,3"
                                                Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.Bg.Control}"
                                                BorderBrush="{DynamicResource Brush.Bg.App}" BorderThickness="2"
                                                Visibility="{Binding IsNotificationMuted, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Chấm trạng thái: Online (🟢), Hibernated (💤), ProxyError (🔴) -->
                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,3">
                                            <Ellipse Width="12" Height="12" Stroke="{DynamicResource Brush.Bg.App}" StrokeThickness="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Hibernated">
                                                                <Setter Property="Fill" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="ProxyError">
                                                                <Setter Property="Fill" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connecting">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Text}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ZONE 2 & 3: CENTER WORKSPACE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ZONE 2: Header -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAccount.DisplayName, FallbackValue='Chưa chọn tài khoản'}"
                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="{Binding SelectedAccount.PlatformColor, FallbackValue=#0068FF}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAccount.PlatformName, FallbackValue=''}" FontSize="11" Foreground="White"/>
                            </Border>
                            <Border Background="{DynamicResource Brush.Accent.SoftBg}" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAccount.TagCategory, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource Brush.Accent.TextSoft}"/>
                            </Border>
                            <!-- Chip mạng: "Ping 42ms", chi tiết Proxy/Direct IP nằm trong tooltip -->
                            <Border BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                    Cursor="Hand" MouseLeftButtonDown="EditSelectedAccountProxy_Click"
                                    ToolTipService.InitialShowDelay="250">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Disabled}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedAccount.NetworkTooltipTitle, FallbackValue='Mạng trực tiếp (Direct IP)'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedAccount.NetworkTooltipStatus, FallbackValue='Nhấn để cấu hình Proxy'}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Border.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Icon khiên khi đi qua Proxy, chấm trạng thái khi mạng trực tiếp -->
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource StatusIconStyle}" Foreground="{DynamicResource Brush.Accent.Text}"
                                               Visibility="{Binding SelectedAccount.HasProxy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Slow">
                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Error">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Unknown">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Disabled}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.HasProxy}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Error">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SelectedAccount.PingChipText, FallbackValue='Ping —'}" FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Good">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Slow">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAccount.PingLevel}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE72C;" Command="{Binding ReloadCurrentAccountCommand}" Style="{StaticResource IconButtonStyle}"
                                    AutomationProperties.Name="Tải lại">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="Tải lại trang" FontWeight="SemiBold"/>
                                        <TextBlock Text="F5" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="&#xE769;" Command="{Binding HibernateCurrentAccountCommand}" Style="{StaticResource IconButtonStyle}"
                                    AutomationProperties.Name="Tạm dừng">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="Tạm dừng tài khoản" FontWeight="SemiBold"/>
                                        <TextBlock Text="Giải phóng bộ nhớ, vẫn giữ đăng nhập" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="&#xE8B7;" Command="{Binding OpenProfileFolderCommand}" Style="{StaticResource IconButtonStyle}"
                                    AutomationProperties.Name="Mở thư mục dữ liệu" ToolTip="Mở thư mục dữ liệu"/>
                            <Border Width="1" Height="20" Background="{DynamicResource Brush.Border.Subtle}" Margin="6,0" VerticalAlignment="Center"/>
                            <!-- Chuyển giao diện: Theo Windows -> Sáng -> Tối -->
                            <Button Content="{Binding ThemeGlyph}" Command="{Binding CycleThemeCommand}" Style="{StaticResource IconButtonStyle}"
                                    AutomationProperties.Name="Đổi giao diện sáng tối">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ThemeTooltipTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ThemeTooltipHint}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="&#xE72E;" Command="{Binding LockWorkspaceCommand}" Style="{StaticResource IconButtonStyle}"
                                    AutomationProperties.Name="Khóa nhanh">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="Khóa nhanh" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ctrl + L" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="&#xE713;" Style="{StaticResource IconButtonStyle}" Click="OpenSettings_Click"
                                    ToolTip="Cài đặt" AutomationProperties.Name="Cài đặt"
                                    Visibility="{Binding IsHorizontalLayout, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="&#xE90D;" Command="{Binding ToggleRightDrawerCommand}" Style="{StaticResource DrawerToggleIconButtonStyle}"
                                    AutomationProperties.Name="Ẩn hoặc hiện bảng Tin mẫu và Ghi chú">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="Ẩn/hiện bảng Tin mẫu và Ghi chú" FontWeight="SemiBold"/>
                                        
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- THANH THÔNG BÁO NỔI IN-APP KHI CÓ TIN NHẮN TỪ TÀI KHOẢN KHÁC -->
                <Border Grid.Row="1" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="0,0,0,1" Padding="14,8"
                        Visibility="{Binding IsInAppNotificationVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Xem ngay ➔" Command="{Binding SwitchToNotifiedAccountCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}" Background="#0068FF" BorderBrush="#60A5FA"
                                    Foreground="White" FontWeight="SemiBold" FontSize="11" Padding="10,4"/>
                            <Button Content="✕" Command="{Binding DismissNotificationCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}" Background="Transparent" BorderThickness="0"
                                    Foreground="#93C5FD" FontSize="12" Padding="6,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NotificationHeader}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NotificationBody}" FontSize="12" Foreground="#DBEAFE" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ZONE 3: WebView2 Host Container -->
                <Grid Grid.Row="2" Background="{DynamicResource Brush.Bg.Main}">
                    <!-- Màn hình chờ khi tài khoản đang ở chế độ Ngủ đông / Chưa khởi chạy / Lỗi Proxy -->
                    <Border Background="{DynamicResource Brush.Bg.Main}" Panel.ZIndex="1"
                            Visibility="{Binding ShowPlaceholderOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.Bg.Control}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="💬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedAccount.DisplayName, StringFormat='{}{0}'}" 
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedAccount.PlatformName, StringFormat='Tài khoản chưa mở. Bấm Khởi chạy để vào {0}.'}" 
                                       FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedAccount.StatusMessage}" 
                                       FontSize="12" Foreground="{DynamicResource Brush.Warning.Text}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Khởi chạy" Width="120" Height="38"
                                        Command="{Binding StartOrWakeSelectedAccountCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Cấu hình" Width="120" Height="38" Margin="8,0,0,0"
                                        Click="EditSelectedAccountProxy_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Grid chứa tất cả các thực thể WebView2 độc lập (Ẩn khi mở Dialog/Lock để chống lỗi WPF Airspace) -->
                    <Grid x:Name="WebViewHostGrid" Background="{DynamicResource Brush.Bg.Main}"
                          Visibility="{Binding IsWebViewAirspaceClear, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>

            <!-- ZONE 4: RIGHT PRODUCTIVITY DRAWER -->
            <Border Grid.Column="2" Width="300" Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsRightDrawerOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- Thanh chuyển đổi Tin mẫu / Ghi chú KH -->
                    <Border DockPanel.Dock="Top" Height="46" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tin mẫu" Command="{Binding SwitchToQuickReplyTabCommand}"
                                        Style="{StaticResource DrawerTabButtonStyle}" Tag="{Binding IsQuickReplyTabActive}"/>
                                <Button Content="Ghi chú" Command="{Binding SwitchToCustomerNotesTabCommand}"
                                        Style="{StaticResource DrawerTabButtonStyle}" Tag="{Binding IsCustomerNotesTabActive}"/>
                                <Button Content="Dịch" Command="{Binding SwitchToTranslateTabCommand}"
                                        Style="{StaticResource DrawerTabButtonStyle}" Tag="{Binding IsTranslateTabActive}"
                                        ToolTip="Dịch tin nhắn (bôi đen + Ctrl+Shift+D)"/>
                            </StackPanel>
                            <Button Content="+ Thêm" HorizontalAlignment="Right" Click="AddQuickReply_Click"
                                    Visibility="{Binding IsQuickReplyTabActive, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource ToolbarButtonStyle}" Padding="8,3" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- TAB 1: TIN NHẮN MẪU (QUICK REPLIES) -->
                    <DockPanel Visibility="{Binding IsQuickReplyTabActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                            <!-- Ô tìm kiếm gọn: 1 lớp viền, cao 32px, chữ gợi ý, nút xóa, Esc để xóa -->
                            <Border Height="32" CornerRadius="8" BorderThickness="1" Padding="9,0,4,0"
                                    Background="{DynamicResource Brush.Bg.Control}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Disabled}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="#0068FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource CardIconButtonStyle}"
                                            Width="22" Height="22" FontSize="10"
                                            Command="{Binding ClearQuickReplySearchCommand}"
                                            Visibility="{Binding HasQuickReplySearch, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Xóa tìm kiếm (Esc)" AutomationProperties.Name="Xóa tìm kiếm"/>
                                    <Grid>
                                        <TextBlock Text="Tìm tin mẫu: /chao, báo giá…" FontSize="12" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasQuickReplySearch}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding QuickReplySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 FontSize="12" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Tìm tin mẫu">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Escape" Command="{Binding ClearQuickReplySearchCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding QuickReplyFilterSummary}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="2,6,0,0" Visibility="{Binding HasQuickReplySearch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                            <ItemsControl ItemsSource="{Binding FilteredQuickReplies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:QuickReplyTemplate}">
                                        <Border Style="{StaticResource QuickReplyItemCardStyle}" Background="{DynamicResource Brush.Bg.Control}"
                                                MouseLeftButtonDown="QuickReplyCard_MouseLeftButtonDown" Tag="{Binding}"
                                                ToolTip="Nhấp đúp để sửa tin mẫu" ToolTipService.InitialShowDelay="1200">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border Background="{DynamicResource Brush.Success.SoftBg}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Shortcut}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success.TextSoft}"/>
                                                    </Border>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource CardActionsStyle}">
                                                        <Button Content="&#xE70F;" Style="{StaticResource CardIconButtonStyle}"
                                                                Click="EditQuickReply_Click" Tag="{Binding}"
                                                                ToolTip="Sửa tin mẫu" AutomationProperties.Name="Sửa tin mẫu"/>
                                                        <Button Content="&#xE74D;" Style="{StaticResource CardIconButtonStyle}"
                                                                Click="DeleteQuickReply_Click" Tag="{Binding}"
                                                                ToolTip="Xóa tin mẫu" AutomationProperties.Name="Xóa tin mẫu"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock Text="Kèm ảnh" FontSize="11" Foreground="{DynamicResource Brush.Accent.Text}" Margin="0,0,0,8"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Chèn"
                                                            Command="{Binding DataContext.InsertQuickReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ToolbarButtonStyle}" FontSize="11" Padding="8,3"/>
                                                    <Button Content="Gửi"
                                                            Command="{Binding DataContext.SendQuickReplyNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Padding="8,3" Margin="4,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- TAB 3: DỊCH TIN NHẮN -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                  Visibility="{Binding IsTranslateTabActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- B: dịch đoạn đã chọn -->
                            <Border Style="{StaticResource TranslateCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="&#xE8B3;" Style="{StaticResource CardIconButtonStyle}"
                                                Command="{Binding GrabSelectionAndTranslateCommand}"
                                                ToolTip="Lấy đoạn đang bôi đen trong khung chat (Ctrl+Shift+D)"
                                                AutomationProperties.Name="Lấy đoạn đang bôi đen"/>
                                        <TextBlock Text="Dịch đoạn đã chọn" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </DockPanel>
                                    <TextBlock Text="Bôi đen chữ trong khung chat rồi bấm Ctrl+Shift+D, hoặc dán vào ô dưới." FontSize="10.5"
                                               Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ReadText, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12"
                                             AutomationProperties.Name="Đoạn cần dịch"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding SourceLanguageList}" SelectedItem="{Binding ReadSource}"
                                                  DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Dịch từ"/>
                                        <Button Grid.Column="1" Content="&#xE8AB;" Style="{StaticResource CardIconButtonStyle}" Margin="4,0"
                                                Command="{Binding SwapReadLanguagesCommand}" ToolTip="Đảo chiều" AutomationProperties.Name="Đảo chiều"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TargetLanguageList}" SelectedItem="{Binding ReadTarget}"
                                                  DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Dịch sang"/>
                                    </Grid>
                                    <Button Content="Dịch" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                                            Padding="14,4" FontSize="11" Margin="0,8,0,0" Command="{Binding TranslateReadCommand}"/>
                                    <TextBox Text="{Binding ReadResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40"
                                             FontSize="12.5" Margin="0,8,0,0" AutomationProperties.Name="Bản dịch"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource CardIconButtonStyle}"
                                                Command="{Binding CopyReadResultCommand}" ToolTip="Sao chép bản dịch" AutomationProperties.Name="Sao chép bản dịch"/>
                                        <TextBlock Text="{Binding ReadDetectedText}" FontSize="11" Foreground="{DynamicResource Brush.Success.TextSoft}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- C: soạn tin gửi khách -->
                            <Border Style="{StaticResource TranslateCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Soạn tin gửi khách" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBox Text="{Binding ComposeText, UpdateSourceTrigger=PropertyChanged}" Height="62" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12"
                                             AutomationProperties.Name="Nội dung cần dịch để gửi"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding SourceLanguageList}" SelectedItem="{Binding ComposeSource}"
                                                  DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Soạn bằng"/>
                                        <Button Grid.Column="1" Content="&#xE8AB;" Style="{StaticResource CardIconButtonStyle}" Margin="4,0"
                                                Command="{Binding SwapComposeLanguagesCommand}" ToolTip="Đảo chiều" AutomationProperties.Name="Đảo chiều soạn tin"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TargetLanguageList}" SelectedItem="{Binding ComposeTarget}"
                                                  DisplayMemberPath="Name" FontSize="11" AutomationProperties.Name="Gửi bằng"/>
                                    </Grid>
                                    <!-- Ngôn ngữ ghim: chọn nhanh ngôn ngữ đích -->
                                    <ItemsControl ItemsSource="{Binding PinnedLanguages}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Native}" FontSize="10.5" Padding="8,2" Margin="0,0,4,4"
                                                        Command="{Binding DataContext.PickPinnedTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Dịch sang ngôn ngữ này"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Dịch" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                                            Padding="14,4" FontSize="11" Margin="0,2,0,0" Command="{Binding TranslateComposeCommand}"/>
                                    <TextBox Text="{Binding ComposeResult, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="44"
                                             AcceptsReturn="True" FontSize="12.5" Margin="0,8,0,0" ToolTip="Có thể sửa bản dịch trước khi gửi"
                                             AutomationProperties.Name="Bản dịch để gửi"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Chèn" Style="{StaticResource ToolbarButtonStyle}" FontSize="11" Padding="10,3"
                                                Command="{Binding InsertComposeResultCommand}" ToolTip="Chèn vào ô chat để sửa thêm"/>
                                        <Button Content="Gửi" Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Padding="12,3" Margin="4,0,0,0"
                                                Command="{Binding SendComposeResultCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Lỗi + dịch lại bằng Google Dịch -->
                            <Border Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,10"
                                    Visibility="{Binding HasTranslateError, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TranslateError}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger.Text}"/>
                                    <Button Content="Dịch bằng Google Dịch" HorizontalAlignment="Left" FontSize="11" Padding="10,3" Margin="0,8,0,0"
                                            Command="{Binding FallbackToGoogleCommand}"
                                            Visibility="{Binding CanFallbackToGoogle, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap">
                                <Run Text="Đang dùng:"/> <Run Text="{Binding TranslateProviderText, Mode=OneWay}"/><Run Text=". Đổi trong Cài đặt → Dịch."/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: GHI CHÚ KHÁCH HÀNG (MINI-CRM) -->
                    <DockPanel Visibility="{Binding IsCustomerNotesTabActive, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top" Padding="12" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveChatNotesSummary}" FontSize="11" Foreground="{DynamicResource Brush.Success.TextSoft}" Margin="0,0,0,6"
                                           TextWrapping="Wrap" Visibility="{Binding HasActiveChat, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Thêm ghi chú khách hàng" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewNoteCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Bg.Control}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Control}" Padding="6,4" Margin="0,0,0,6"
                                         ToolTip="Tên khách hàng / Hội thoại"/>
                                <TextBox Text="{Binding NewNoteContent, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Bg.Control}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Control}" Padding="6,4" Height="54"
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"
                                         ToolTip="Nội dung ghi chú công nợ, lịch hẹn, báo giá..."/>
                                <Button Content="Lưu ghi chú" Command="{Binding SaveCustomerNoteCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Padding="10,5" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <ItemsControl ItemsSource="{Binding CurrentAccountNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CustomerNote}">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource QuickReplyCardStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActiveChatMatch}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="4,0"
                                                            Command="{Binding DataContext.DeleteCustomerNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" Foreground="{DynamicResource Brush.Text.Muted}" BorderThickness="0" Cursor="Hand"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Accent.TextSoft}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding NoteContent}" FontSize="12" Foreground="{DynamicResource Brush.Text.Body}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat='Cập nhật: {0:dd/MM/yyyy HH:mm}'}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ZONE 5: BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Bản gọn: icon + con số; câu đầy đủ nằm trong tooltip -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding TotalUnreadText}">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource StatusIconStyle}" Foreground="{DynamicResource Brush.Danger.Text}"/>
                        <TextBlock Text="{Binding UnreadShortText}" FontSize="11" Foreground="{DynamicResource Brush.Danger.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding RunningStatsText}">
                        <TextBlock Text="&#xE768;" Style="{StaticResource StatusIconStyle}" Foreground="{DynamicResource Brush.Success.Text}"/>
                        <TextBlock Text="{Binding RunningShortText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding HibernatedStatsText}">
                        <TextBlock Text="&#xE769;" Style="{StaticResource StatusIconStyle}" Foreground="{DynamicResource Brush.Warning.Text}"/>
                        <TextBlock Text="{Binding HibernatedShortText}" FontSize="11" Foreground="{DynamicResource Brush.Warning.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding TotalRamUsageText}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource StatusIconStyle}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{Binding RamShortText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="OpenSettings_Click" ToolTip="{Binding AutoLockStatusText}">
                        <TextBlock Foreground="{DynamicResource Brush.Accent.Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIconStyle}">
                                    <Setter Property="Text" Value="&#xE785;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoLockOn}" Value="True">
                                            <Setter Property="Text" Value="&#xE72E;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AutoLockShortText}" FontSize="11" Foreground="{DynamicResource Brush.Accent.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MÀN HÌNH KHÓA BẢO MẬT MASTER LOCK (Đè lên toàn bộ khi IsLocked = True, WebView2 đã tự ẩn) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource Brush.Overlay.Lock}" Panel.ZIndex="99"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <Border Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Bg.Panel}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="24">
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource Brush.Bg.Control}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ứng dụng đang khóa" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Nhập mã PIN để mở khóa."
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBox x:Name="PinLockInputBox"
                             Text="{Binding PinInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.Bg.Control}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Control}" Padding="10,8"
                             FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"
                             KeyDown="PinLockInputBox_KeyDown"/>

                    <TextBlock Text="{Binding LockErrorMessage}" Foreground="{DynamicResource Brush.Danger.Text}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Button Content="Mở khóa" Height="38"
                            Command="{Binding UnlockWorkspaceCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

